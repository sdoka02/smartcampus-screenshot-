        "z": "tab-flow1",
        "name": "generatore potenza ",
        "func": "const rooms = [\"aulaVP.01\", \"aulaVP.02\", \"aulaVP.03\", \"aulaVP.04\"];\n\n\n// Genera un messaggio MQTT per ogni aula\nconst msgs = rooms.map((room, i) => {\n  // Simula il consumo elettrico istantaneo tra 0.1 e 2.5 kW\n  const kw = Number((0.1 + Math.random() * 2.4).toFixed(2));\n\n  return {\n    topic: `smartcampus/power/${room}`,   // Topic MQTT specifico per aula\n    payload: {\n      device: `sensor-power-${i + 1}`,   // ID sensore univoco\n      type: \"power\",                     // Tipo di sensore\n      value: kw,                         // Valore numerico simulato\n      unit: \"kW\",                        // Unità di misura\n      ts: Date.now(),                    // Timestamp in millisecondi\n      location: room                     // Aula di riferimento\n    }\n  };\n});\n\n// Invia i messaggi generati\nmsgs.forEach(m => node.send(m));\n\nreturn null;\n",
