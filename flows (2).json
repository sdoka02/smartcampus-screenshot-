    {
        "id": "5252fe7fcbf74804",
        "type": "function",
        "z": "tab-flow1",
        "name": "mapper",
        "func": "// 1. Normalizza payload: stringa JSON -> oggetto\nlet p = msg.payload;\nif (typeof p === \"string\") {\n  try { p = JSON.parse(p); }\n  catch (e) {\n    node.warn(\"payload JSON non valido\");\n    return null;\n  }\n}\n\n// Controllo minimo: serve almeno type e value\nif (!p || p.type === undefined || p.value === undefined) {\n  node.warn(\"payload senza type o value\");\n  return null;\n}\n\n// 2. Mappa type -> measurement e campo principale\nconst MAP = {\n  temperature: { measurement: \"temperature\", field: \"value\" },\n  humidity: { measurement: \"humidity\", field: \"value\" },\n  co2: { measurement: \"co2\", field: \"value\" },\n  illuminance: { measurement: \"illuminance\", field: \"value\" },\n  noise: { measurement: \"noise\", field: \"value\" },\n  power: { measurement: \"power\", field: \"value\" },\n  occupation: { measurement: \"occupation\", field: \"value\" },\n  lock: { measurement: \"lock\", field: \"state\" },   // ON/OFF\n  camera_status: { measurement: \"camera\", field: \"online\" }   // 1/0\n};\n\nconst t = String(p.type).toLowerCase();\nconst map = MAP[t];\nif (!map) {\n  node.warn(`tipo non mappato: ${t}`);\n  return null;\n}\n\n// 3. TAGS (sempre stringhe)\nconst tags = {\n  device: String(p.device || \"unknown\"),\n  location: String(p.location || \"unknown\"),\n  unit: String(p.unit || \"none\").toLowerCase()\n};\n\n// 4. FIELDS (numerici dove serve)\nconst fields = {};\n\nif (map.field === \"value\") {\n  const n = Number(p.value);\n  if (!Number.isFinite(n)) {\n    node.warn(\"value non numerico\");\n    return null;\n  }\n  fields.value = n;\n\n} else if (map.field === \"state\") {\n  // lock: ON/OFF -> 1/0 + tag testo\n  const on = String(p.value).toUpperCase() === \"ON\" ? 1 : 0;\n  fields.state = on;\n  tags.state_text = String(p.value).toUpperCase();\n\n} else if (map.field === \"online\") {\n  // camera_status: 1/0\n  const online = Number(p.value) === 1 ? 1 : 0;\n  fields.online = online;\n}\n\n// Se c'è motion_event dalla camera lo salvo come field numerico\nif (p.motion_event !== undefined) {\n  const mv = Number(p.motion_event);\n  if (Number.isFinite(mv)) {\n    fields.motion_event = mv;\n  }\n}\n\n// 5. Timestamp in millisecondi (coerente con Date.now() e nodo influx)\nlet timestamp;\nif (p.ts !== undefined && Number.isFinite(Number(p.ts))) {\n  timestamp = String(p.ts);  // è già in ms\n}\n\n// 6. Costruisco il \"point\" per il nodo InfluxDB\nconst point = {\n  measurement: map.measurement,\n  tags,\n  fields\n};\nif (timestamp) point.timestamp = timestamp;\n\n// Formato v2: array di points\nmsg.payload = [point];\n\n// Per compatibilità con il nodo influx-out\nmsg.measurement = point.measurement;\nmsg.tags = point.tags;\nmsg.fields = point.fields;\nif (timestamp) msg.timestamp = point.timestamp;\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
