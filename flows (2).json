        "id": "8e116fc96410b29d",
        "type": "function",
        "z": "tab-flow1",
        "name": "generatore telecamere ",
        "func": "const rooms = [\"aulaVP.01\", \"aulaVP.02\", \"aulaVP.03\", \"aulaVP.04\"];\n\n\nrooms.forEach((room, i) => {\n  // 90% online: confronto con 0.9 (se random < 0.9 => 1).\n  const online = Math.random() < 0.9 ? 1 : 0;\n\n  // Evento movimento: può accadere SOLO se online.\n  // 20% di probabilità quando online.\n  const motion = online && Math.random() < 0.2 ? 1 : 0;\n\n  node.send({\n    topic: `smartcampus/cameras/${room}`, // Topic “cameras” per aula\n    payload: {\n      device: `camera-${i+1}`,            // ID camera\n      type: \"camera_status\",              // Tipo dato (stato camera)\n      value: online,                      // 1=online, 0=offline\n      motion_event: motion,               // 1=movimento, 0=nessuno\n      ts: Date.now(),                     // Timestamp\n      location: room                      // Aula\n    }\n  });\n});\n\nreturn null;\n",
