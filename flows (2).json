    {
        "id": "fn-temp",
        "type": "function",
        "z": "tab-flow1",
        "name": "generatore temperatura",
        "func": "// Definiamo l'elenco delle aule come array di stringhe.\nconst rooms = [\"aulaVP.01\", \"aulaVP.02\", \"aulaVP.03\", \"aulaVP.04\"];\n// Per ogni aula dell'array eseguiamo una funzione.\nrooms.forEach((room, i) => {\n  // Calcoliamo un valore di temperatura casuale tra 20 e 28 gradi.\n  // Math.random() restituisce [0,1); *8 lo porta a [0,8).\n  // toFixed(1) limita a 1 decimale ma ritorna stringa; Number() la riporta a numero.\n  const value = Number((20 + Math.random() * 8).toFixed(1)); // 20–28 °C\n\n  // node.send invia un singolo messaggio verso il nodo successivo.\n  node.send({\n    // Qui includiamo l'aula nel percorso del topic.\n    topic: `smartcampus/temperature/${room}`,\n  // il contenuto del messaggio.\n    payload: {\n      // Identificatore univoco del dispositivo: usiamo l'indice i (0-based) + 1.\n      device: `sensor-temperature-${i + 1}`,\n      // Tipo logico del dato\n      type: \"temperature\",\n      // Valore numerico della misura.\n      value,\n      // Unità di misura come stringa (qui gradi Celsius).\n      unit: \"°C\",\n      // Timestamp in millisecondi.\n      ts: Date.now(),\n      // Metadato: l’aula di provenienza (uguale alla parte finale del topic).\n      location: room\n    }\n  });\n});\nreturn null;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 100,
        "wires": [
            [
                "pub-temp0",
                "pub-temp1"
            ]
        ]
