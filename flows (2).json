    {
        "id": "e2147f89ae7dddd0",
        "type": "function",
        "z": "tab-flow1",
        "name": "generatore occupazione",
        "func": "\n// Mappa aula -> capienza massima (numero di posti).\nconst capacities = {\n  \"aulaVP.01\": 40,\n  \"aulaVP.02\": 30,\n  \"aulaVP.03\": 32,\n  \"aulaVP.04\": 36\n};\n\n// Object.entries restituisce array di coppie [chiave, valore] => [room, cap].\n// idx è l'indice dell'iterazione, utile per generare un device id coerente.\nObject.entries(capacities).forEach(([room, cap], idx) => {\n  // mean = 50% della capienza (tendenza centrale).\n  const mean = cap * 0.5;\n\n  // Rumore casuale: (Math.random()-0.5) in [-0.5..+0.5),\n  // moltiplicato per cap*0.6 (±30% circa attorno alla media).\n  let occ = Math.round(mean + (Math.random() - 0.5) * cap * 0.6);\n\n  //  NON vogliamo valori negativi.\n  if (occ < 0) occ = 0;\n\n  //  NON vogliamo superare la capienza.\n  if (occ > cap) occ = cap;\n\n  node.send({\n    topic: `smartcampus/occupation/${room}`, // Topic “occupation” per aula\n    payload: {\n      device: `sensor-occupancy-${idx+1}`,   // ID sensore di occupazione\n      type: \"occupation\",                     // Tipo dato\n      value: occ,                             // Valore intero: persone presenti\n      capacity: cap,                          // Metadato: capienza massima\n      ts: Date.now(),                         // Timestamp\n      location: room                          // Aula\n    }\n  });\n});\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
